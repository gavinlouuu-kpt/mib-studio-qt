    },
    {
      "name": "brightness_variance",
      "word": 14,
      "bits": [
        0,
        31
      ],
      "format": "q24_8",
      "source": "population variance of the raw gray over the filled cell (meanStdDev stddev^2)"
    }
  ],
  "frame_flags": "EMPTY = no cell passed the size gate; RESULTS_TRUNCATED = more cells than the stage lists, or the stage deadline (PL register 49, default 180 us after SOF) stopped the list (cell and blemish counts stay complete; the measured cells are reported); DEADLINE = the deadline cut the list (stage flag bit 5)",
  "tables": {
    "PROFILE_TABLE0": {
      "name": "emodulus_lut",
      "layout": "row-major [deformability][area], 200 x 200 u16 kPa in q8_8, little-endian; 0xFFFF = no value (NaN on the host)",
      "bytes": 80000,
      "axes": "page words 19-21",
      "source": "EModulusLut grid (IDW from the TSV), built on the PS"
    }
  },
  "conformance_tolerances": {
    "integer_fields": "exact",
    "ratios_and_deformability": "1e-4 absolute",
    "emodulus": "within one LUT cell of the host bilinear value",
    "centroid": "1/256 px",
    "laplacian_variance": "exact integer sums; Q24.8 rounding of the variance (relative 2.3e-8 measured)",
    "brightness": "exact integer sums; Q16.16 / Q24.8 rounding of mean and variance"
  }
}
