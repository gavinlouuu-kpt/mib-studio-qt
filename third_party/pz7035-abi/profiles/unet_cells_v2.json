  "payload_words": 15,
  "payload_validity": "bit n set = payload word n valid; a cut-off or degenerate cell carries words 0, 1, 6, 7, 8, 11, 12, 13, 14 (brightness, centroid and Laplacian are computed before the border exit, as on the host)",
  "payload": [
    {
      "name": "object_id",
      "word": 0,
      "bits": [
        0,
        15
      ],
      "format": "u16",
      "source": "objectId (1..N, cell bbox order)"
    },
    {
      "name": "reason",
      "word": 0,
      "bits": [
        16,
        19
      ],
      "format": "enum:reason",
