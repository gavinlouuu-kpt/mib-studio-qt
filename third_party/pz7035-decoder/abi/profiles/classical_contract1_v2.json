  "tables": {
    "PROFILE_TABLE1": {
      "name": "emodulus_table_v2",
      "layout": "row-major [deformability][area], 200 x 200 cells, cell k = d * 200 + a. Bytes 0-159,999: value of cell k as u32 kPa in q16_16, little-endian, at 4k. Bytes 160,000-164,999: validity bitmap, bit (k mod 8) of byte 160,000 + k / 8; set = value present, cleared = no value (NaN on the host; the value word is ignored and should be 0)",
      "bytes": 165000,
      "axes": "page words 22-27 (area q32_32 um^2, deformability q0_32); cell (d, a) is at area_min + a * area_step, deformability_min + d * deformability_step",
      "builder": "the host quantises its EModulusLut grid: value = round(E * 2^16) (half up), E must be finite and in [0, 65536) else the build fails; NaN -> bit cleared; axes = round(x * 2^32). Constraints (the page loader of the host rejects violations): 0 < area_step < 2^44 (4096 um^2), area_min < 2^52 (2^20 um^2), 0 < deformability_step < 2^32, deformability_min < 2^32",
      "source": "mib-studio-qt EModulusLut grid (IDW from the TSV)",
      "evaluator": "inputs are exactly the payload fields area_um2 (q16_16, saturated) and deformability (q0_16). X = area << 16, Y = deformability << 16; NaN (emodulus_out_of_coverage) unless area_min <= X <= area_min + 199 area_step and deformability_min <= Y <= deformability_min + 199 deformability_step (inclusive at both ends, as EModulusLut::lookup). ia = floor((X - area_min) 2^32 / area_step), a0 = min(ia >> 32, 199), a1 = min(a0 + 1, 199), fa = ia - a0 2^32 (q0_32); the same for deformability. NaN if any of the four cells (d0|d1, a0|a1) has no value, also at weight 0 (as the host). top = v00 (2^32 - fa) + v10 fa, bot = v01 (2^32 - fa) + v11 fa, E = (top (2^32 - fd) + bot fd + 2^63) >> 64 (q16_16, one rounding). Vectors: tests/vectors/emod_v2 (tools/emod_ref, EModulusLut at mib-studio-qt ac0a7b08)"
    },
    "BACKGROUND": {
      "layout": "ROI 2 blurred background, 512 x 96 u8, row-major",
      "bytes": 49152,
      "source": "PS auto/calibrated background (mean of empty preview frames)"
    }
  },
  "conformance_tolerances": {
    "integer_fields": "exact",
    "ratios_and_deformability": "1e-4 absolute",
    "emodulus": "1e-4 kPa absolute against EModulusLut::lookup on the loaded v2 table for the same (area_um2, deformability) payload values, and the same NaN decision (vectors tests/vectors/emod_v2; bound 2^-17 kPa final rounding + 2^-32 |cell difference| per axis from the q0_32 weights, <= 3.8e-5 kPa)",
    "centroid": "1/256 px"
  }
