{
    "config_schema_version": 1,
    "buffer_threshold": 1000,
    "camera": {
        "frame_delivery_mode": "everyFrame"
    },
    "realtime_processing": {
        "mode": "inline",
        "batch_size": 16,
        "max_queued_frames": 4096,
        "worker_count": 1,
        "max_batch_delay_ms": 10
    },
    "image_processing": {
        "area_threshold_max": 290,
        "area_threshold_min": 60,
        "deformability_threshold_min": 0.0,
        "deformability_threshold_max": 0.5,
        "area_ratio_threshold_max": 1.5,
        "ring_ratio_min": 15.0,
        "ring_ratio_max": 25.0,
        "bg_subtract_threshold": 8,
        "empty_frame_pixel_threshold": 100,
        "auto_background_enabled": false,
        "auto_background_empty_frames": 30,
        "auto_background_cooldown_frames": 1000,
        "filters": {
            "enable_area_range_check": true,
            "enable_border_check": true,
            "enable_area_ratio_check": false,
            "enable_deformability_range_check": true,
            "enable_ring_ratio_check": true,
            "enable_multiple_contours_check": true,
            "require_single_inner_contour": true
        },
        "gaussian_blur_size": 3,
        "morph_iterations": 1,
        "morph_kernel_size": 3,
        "target_group": {
            "enabled": false,
            "area_min": 72,
            "area_max": 191,
            "deformability_min": 0.0,
            "deformability_max": 0.3,
            "emodulus_enabled": false,
            "emodulus_min": 0.0,
            "emodulus_max": 10.0
        },
        "multi_image": {
            "enabled": false,
            "count": 1
        }
    },
    "save_directory": "testing",
    "scatter_plot_enabled": true,
    "target_fps": 5000,
    "autofocus_com_port": 6,
    "autofocus_baud_rate": 115200,
    "autofocus_device_address": 1,
    "autofocus_focus_setpoint": 20.0,
    "autofocus_focus_range": 0.5,
    "autofocus_voltage_step": 1.0,
    "autofocus_fine_voltage_step": 0.2,
    "autofocus_max_voltage": 100.0,
    "autofocus_min_voltage": 0.0,
    "autofocus_initial_voltage": 50.0,
    "autofocus_manual_voltage_step": 1.0,
    "autofocus_min_samples_per_step": 100,
    "ring_ratio_stale_ms": 1500,
    "require_new_sample_per_step": true,
    "display_fps": 60,
    "safe_shutdown_voltage": 0.0,
    "focus_direction": true,
    "pixel_to_micron_factor": 0.4886
}
