{
  "name": "mib-studio-desktop",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "description": "MIB Studio and YOFO Review desktop shells (React + Tauri v2) — epic #246",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
