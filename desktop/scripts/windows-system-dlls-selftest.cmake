# Drives windows-system-dlls.cmake on any host (#851): cmake -DMODE=<mode> ... -P this file.
#   MODE=classify  -DPATHS=<;-list> [-DSYSTEM_ROOT=...]  prints "<path> => system|keep" per path
#   MODE=regex     -DPATHS=<;-list>                      prints which paths a POST_EXCLUDE regex matches
#   MODE=check     -DDEST=<dir> [-DSYSTEM_ROOT=...]      runs the staged-runtime check
cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/windows-system-dlls.cmake")
if(NOT DEFINED SYSTEM_ROOT)
  set(SYSTEM_ROOT "")
endif()
if(MODE STREQUAL "classify")
  foreach(path IN LISTS PATHS)
    mib_is_windows_system_dll("${path}" "${SYSTEM_ROOT}" is_system)
    if(is_system)
      message("${path} => system")
    else()
      message("${path} => keep")
    endif()
  endforeach()
elseif(MODE STREQUAL "regex")
  foreach(path IN LISTS PATHS)
    set(hit keep)
    foreach(regex IN LISTS MIB_WINDOWS_SYSTEM_DLL_REGEXES)
      if(path MATCHES "${regex}")
        set(hit system)
      endif()
    endforeach()
    message("${path} => ${hit}")
  endforeach()
elseif(MODE STREQUAL "check")
  mib_check_staged_runtime("${DEST}" "${SYSTEM_ROOT}")
  message("staged runtime OK")
else()
  message(FATAL_ERROR "MODE must be classify, regex or check")
endif()
