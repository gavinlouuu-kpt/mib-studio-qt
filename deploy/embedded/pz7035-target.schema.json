{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://updates.yofo.bio/schemas/pz7035-target.schema.json",
  "title": "MIB Studio standalone embedded target manifest",
  "description": "Machine-readable target / ownership / capability / budget contract for the standalone Zynq-7035 instrument (epic #441, E0 #443). Validated by scripts/check_embedded_target.py (subset of JSON Schema: type, required, additionalProperties, enum, const, minimum, pattern, items, properties). Every number carries a status and an evidence class so reviewers can tell a frozen limit from a sizing input or an unknown.",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "reviewed",
    "issues",
    "baseline",
    "evidence_classes",
    "target",
    "boundaries",
    "ownership",
    "budgets",
    "reuse",
    "dependency_allowlist",
    "unknowns"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "reviewed": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "issues": {
      "type": "object",
      "required": [
        "epic",
        "e0",
        "board_contract"
      ],
      "additionalProperties": true,
      "properties": {
        "epic": {
          "type": "string"
        },
        "e0": {
          "type": "string"
        },
        "board_contract": {
          "type": "string"
        }
      }
    },
    "baseline": {
      "type": "object",
      "required": [
        "application",
        "board"
      ],
      "additionalProperties": false,
      "properties": {
        "application": {
          "$ref": "#/$defs/repo_pin"
        },
        "board": {
          "$ref": "#/$defs/repo_pin"
        }
      }
    },
    "evidence_classes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_class"
      }
    },
    "target": {
      "type": "object",
      "required": [
        "soc",
        "processing_system",
        "board",
        "memory",
        "storage",
        "boot",
        "runtime",
        "toolchain",
        "display",
        "peripherals",
        "excluded_targets"
      ],
      "additionalProperties": false,
      "properties": {
        "soc": {
          "type": "object",
          "required": [
            "family",
            "device",
            "package",
            "speed_grade",
            "temperature_grade",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "family": {
              "type": "string",
              "const": "Zynq-7000"
            },
            "device": {
              "type": "string",
              "const": "XC7Z035"
            },
            "package": {
              "type": [
                "string",
                "null"
              ]
            },
            "speed_grade": {
              "type": [
                "string",
                "null"
              ]
            },
            "temperature_grade": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        "processing_system": {
          "type": "object",
          "required": [
            "cpu",
            "isa",
            "address_bits",
            "cores",
            "linux_triplet",
            "max_clock_mhz",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string",
              "const": "Cortex-A9"
            },
            "isa": {
              "type": "string",
              "const": "armv7-a"
            },
            "address_bits": {
              "type": "integer",
              "const": 32
            },
            "cores": {
              "type": "integer",
              "const": 2
            },
            "linux_triplet": {
              "type": "string",
              "const": "arm-linux-gnueabihf"
            },
            "max_clock_mhz": {
              "$ref": "#/$defs/quantity"
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        "board": {
          "type": "object",
          "required": [
            "vendor",
            "model",
            "revision",
            "carrier_or_som",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "vendor": {
              "type": [
                "string",
                "null"
              ]
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "revision": {
              "type": [
                "string",
                "null"
              ]
            },
            "carrier_or_som": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        "memory": {
          "type": "object",
          "required": [
            "ps_ddr_bytes",
            "ps_ddr_type",
            "ps_ddr_width_bits",
            "ocm_bytes",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "ps_ddr_bytes": {
              "$ref": "#/$defs/quantity"
            },
            "ps_ddr_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "ps_ddr_width_bits": {
              "$ref": "#/$defs/quantity"
            },
            "ocm_bytes": {
              "$ref": "#/$defs/quantity"
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        "storage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "interface",
              "media",
              "capacity_bytes",
              "role",
              "evidence"
            ],
            "additionalProperties": false,
            "properties": {
              "interface": {
                "type": "string"
              },
              "media": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "capacity_bytes": {
                "$ref": "#/$defs/quantity"
              },
              "role": {
                "type": "string",
                "enum": [
                  "boot",
                  "rootfs",
                  "data",
                  "unknown",
                  "unused"
                ]
              },
              "evidence": {
                "$ref": "#/$defs/evidence"
              }
            }
          }
        },
        "boot": {
          "type": "object",
          "required": [
            "source",
            "chain",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": [
                "string",
                "null"
              ]
            },
            "chain": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        "runtime": {
          "type": "object",
          "required": [
            "proposed",
            "status",
            "bare_metal",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "proposed": {
              "type": "string",
              "const": "arm-linux"
            },
            "status": {
              "type": "string",
              "enum": [
                "proposed",
                "accepted",
                "rejected"
              ]
            },
            "bare_metal": {
              "type": "string"
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        "toolchain": {
          "type": "object",
          "required": [
            "vivado",
            "firmware_compiler",
            "linux_bsp",
            "kernel",
            "device_tree",
            "cross_compiler",
            "sysroot",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "vivado": {
              "type": [
                "string",
                "null"
              ]
            },
            "firmware_compiler": {
              "type": [
                "string",
                "null"
              ]
            },
            "linux_bsp": {
              "type": [
                "string",
                "null"
              ]
            },
            "kernel": {
              "type": [
                "string",
                "null"
              ]
            },
            "device_tree": {
              "type": [
                "string",
                "null"
              ]
            },
            "cross_compiler": {
              "type": [
                "string",
                "null"
              ]
            },
            "sysroot": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        "display": {
          "type": "object",
          "required": [
            "class",
            "width_px",
            "height_px",
            "interface",
            "touch",
            "panel_timing",
            "backlight",
            "orientation",
            "linux_drivers",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "class": {
              "type": "string"
            },
            "width_px": {
              "type": "integer",
              "const": 1024
            },
            "height_px": {
              "type": "integer",
              "const": 600
            },
            "interface": {
              "type": "string"
            },
            "touch": {
              "type": "object",
              "required": [
                "kind",
                "controller",
                "bus",
                "reset_gpio",
                "interrupt_gpio"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "capacitive"
                },
                "controller": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "bus": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reset_gpio": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "interrupt_gpio": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "panel_timing": {
              "type": [
                "object",
                "null"
              ]
            },
            "backlight": {
              "type": [
                "string",
                "null"
              ]
            },
            "orientation": {
              "type": [
                "string",
                "null"
              ]
            },
            "linux_drivers": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        "peripherals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "bus",
              "endpoint",
              "required_for_standalone",
              "arm_driver",
              "evidence"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "bus": {
                "type": "string"
              },
              "endpoint": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "required_for_standalone": {
                "type": "boolean"
              },
              "arm_driver": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence": {
                "$ref": "#/$defs/evidence"
              }
            }
          }
        },
        "excluded_targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Architectures/boards whose evidence must never be read as XC7Z035 evidence. The validator forbids these tokens everywhere else inside `target` and `dependency_allowlist`."
        }
      }
    },
    "boundaries": {
      "type": "object",
      "required": [
        "native_plugin_abi",
        "local_application_ipc",
        "ps_pl_wire"
      ],
      "additionalProperties": false,
      "properties": {
        "native_plugin_abi": {
          "$ref": "#/$defs/boundary"
        },
        "local_application_ipc": {
          "$ref": "#/$defs/boundary"
        },
        "ps_pl_wire": {
          "$ref": "#/$defs/boundary"
        }
      }
    },
    "ownership": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "operation",
          "owner",
          "path",
          "data",
          "rate_or_deadline",
          "failure_policy",
          "test",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "operation": {
            "type": "string"
          },
          "owner": {
            "type": "string",
            "enum": [
              "PL",
              "PS",
              "UI"
            ]
          },
          "path": {
            "type": "string"
          },
          "data": {
            "type": "string"
          },
          "rate_or_deadline": {
            "type": "string"
          },
          "failure_policy": {
            "type": "string"
          },
          "test": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "implemented",
              "partial",
              "planned",
              "unresolved"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/budget"
      }
    },
    "reuse": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capability",
          "code",
          "tests",
          "evidence",
          "gap",
          "owner"
        ],
        "additionalProperties": false,
        "properties": {
          "capability": {
            "type": "string"
          },
          "code": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          },
          "gap": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "not_transferable": {
            "type": "string"
          }
        }
      }
    },
    "dependency_allowlist": {
      "type": "object",
      "required": [
        "arm_runtime",
        "host_reference_tests",
        "touchscreen",
        "forbidden_in_arm_runtime"
      ],
      "additionalProperties": false,
      "properties": {
        "arm_runtime": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "host_reference_tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "touchscreen": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "forbidden_in_arm_runtime": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "owner",
          "blocks",
          "does_not_block"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^U[0-9]+$"
          },
          "description": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "does_not_block": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "evidence_class": {
      "type": "string",
      "enum": [
        "source-review",
        "compilation",
        "emulation",
        "simulation",
        "synthesis",
        "target-software-test",
        "physical-acceptance",
        "vendor-documentation",
        "unknown"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "class",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "class": {
          "$ref": "#/$defs/evidence_class"
        },
        "source": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "repo_pin": {
      "type": "object",
      "required": [
        "repository",
        "ref",
        "commit",
        "reviewed"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "reviewed": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "quantity": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "frozen",
            "proposed",
            "sizing-input",
            "unknown"
          ]
        },
        "derivation": {
          "type": "string"
        }
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "status",
        "evidence",
        "overflow_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "frozen",
            "proposed",
            "sizing-input",
            "unknown"
          ]
        },
        "derivation": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "overflow_policy": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        }
      }
    },
    "boundary": {
      "type": "object",
      "required": [
        "owner",
        "version_source",
        "version",
        "status",
        "rule"
      ],
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "string"
        },
        "version_source": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "implemented",
            "planned",
            "board-owned"
          ]
        },
        "rule": {
          "type": "string"
        }
      }
    },
    "dependency": {
      "type": "object",
      "required": [
        "name",
        "reason",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "required",
            "optional",
            "candidate",
            "measure-before-replacing"
          ]
        }
      }
    }
  }
}
