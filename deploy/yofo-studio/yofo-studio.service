[Unit]
Description=YOFO Studio backend and browser UI (loopback 127.0.0.1:8427, no token)
After=network.target

[Service]
Type=simple
# The producer's start-up reads PL registers, which can hang the PS on a blank PL: wait (read-only,
# DEVCFG INT_STS bit 2) until the bitstream is loaded before the server starts.
ExecStartPre=/usr/libexec/yofo-studio/pl-ready
TimeoutStartSec=infinity
Environment=MIB_CAMERA_MODE=aravis
Environment=GENICAM_GENTL32_PATH=/usr/lib/genicam
# The instrument is on an isolated link: no E-modulus LUT manifest fetch at start-up.
Environment=MIB_STUDIO_EMODULUS_LUT_MANIFEST_URL=file:///nonexistent/mib-lut-manifest.json
# Loopback only, no token: reach it through an SSH tunnel (ssh -L 8427:127.0.0.1:8427 board).
# --no-token is refused by the server on any other address.
ExecStart=/usr/bin/yofo-studio-server --listen 127.0.0.1:8427 --no-token \
    --dist /usr/share/yofo-studio/dist --data-dir /var/lib/yofo-studio
Restart=on-failure
RestartSec=3
# The producer maps the PL through /dev/uio*; root until a udev rule hands them to a group.
User=root

[Install]
WantedBy=multi-user.target
