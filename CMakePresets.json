{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "linux-release",
      "displayName": "Linux Release (Conan, no Windows SDKs)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/linux/conan_toolchain.cmake",
        "MIB_ENABLE_HARDWARE_SDKS": "OFF",
        "MIB_ENABLE_MINDVISION": "ON",
        "MIB_ENABLE_WINDOWS_PACKAGING": "OFF",
        "MIB_USE_SENTRY": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-system-release",
      "displayName": "Linux Release (system packages, no Windows SDKs)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-system",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_IGNORE_PREFIX_PATH": "/home/gavin/miniconda3;/home/linuxbrew/.linuxbrew",
        "MIB_ENABLE_HARDWARE_SDKS": "OFF",
        "MIB_ENABLE_MINDVISION": "ON",
        "MIB_ENABLE_WINDOWS_PACKAGING": "OFF",
        "MIB_USE_SENTRY": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-backend-only",
      "displayName": "Linux Backend-only (system packages)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-backend",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_IGNORE_PREFIX_PATH": "/home/gavin/miniconda3;/home/linuxbrew/.linuxbrew",
        "MIB_BUILD_BACKEND_ONLY": "ON",
        "BUILD_TESTING": "ON",
        "MIB_ENABLE_HARDWARE_SDKS": "OFF",
        "MIB_ENABLE_MINDVISION": "ON",
        "MIB_ENABLE_WINDOWS_PACKAGING": "OFF",
        "MIB_USE_SENTRY": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-sentry-release",
      "displayName": "Linux Release (Conan, sentry-native)",
      "inherits": "linux-release",
      "binaryDir": "${sourceDir}/build/linux-sentry",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/linux-sentry/conan_toolchain.cmake",
        "MIB_USE_SENTRY": "ON"
      }
    },
    {
      "name": "windows-default",
      "displayName": "Windows VS2022 x64 (Conan)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/conan_toolchain.cmake",
        "CMAKE_POLICY_DEFAULT_CMP0091": "NEW",
        "MIB_ENABLE_MINDVISION": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-release-build",
      "displayName": "Build Linux Release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-system-release-build",
      "displayName": "Build Linux Release from system packages",
      "configurePreset": "linux-system-release"
    },
    {
      "name": "linux-backend-only-build",
      "displayName": "Build Linux Backend-only",
      "configurePreset": "linux-backend-only"
    },
    {
      "name": "linux-sentry-release-build",
      "displayName": "Build Linux Release with sentry-native",
      "configurePreset": "linux-sentry-release"
    },
    {
      "name": "windows-default-build",
      "displayName": "Build (Debug)",
      "configurePreset": "windows-default",
      "configuration": "Debug"
    },
    {
      "name": "windows-default-build-release",
      "displayName": "Build (Release)",
      "configurePreset": "windows-default",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "linux-test",
      "displayName": "Test Linux Release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 30
      }
    },
    {
      "name": "linux-system-test",
      "displayName": "Test Linux Release from system packages",
      "configurePreset": "linux-system-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 30
      }
    },
    {
      "name": "linux-backend-only-test",
      "displayName": "Test Linux Backend-only",
      "configurePreset": "linux-backend-only",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 30
      }
    },
    {
      "name": "windows-debug-test",
      "displayName": "Test Windows Debug (fast)",
      "configurePreset": "windows-default",
      "configuration": "Debug",
      "filter": {
        "exclude": {
          "label": "integration|hardware"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 30
      }
    },
    {
      "name": "windows-debug-integration-test",
      "displayName": "Test Windows Debug integration",
      "configurePreset": "windows-default",
      "configuration": "Debug",
      "filter": {
        "include": {
          "label": "integration"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 180
      }
    },
    {
      "name": "windows-test",
      "displayName": "Test Windows Release (fast)",
      "configurePreset": "windows-default",
      "configuration": "Release",
      "filter": {
        "exclude": {
          "label": "integration|hardware"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 30
      }
    },
    {
      "name": "windows-hardware-test",
      "displayName": "Test Windows hardware (real devices only)",
      "configurePreset": "windows-default",
      "configuration": "Release",
      "filter": {
        "include": {
          "label": "hardware"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 120
      }
    }
  ]
}
